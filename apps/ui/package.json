{
  "name": "ui",
  "description": "LocalMode UI — shadcn registry + Fumadocs docs site for @localmode/ui Elements",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "registry:build": "pnpm run block-source:generate && tsx scripts/prep-registry-dirs.ts && shadcn build && tsx scripts/strip-registry-blocks.ts && tsx scripts/build-aggregates.ts && tsx scripts/absolutize-registry-deps.ts && tsx scripts/check-no-shipped-telemetry.ts",
    "prebuild": "pnpm run registry:build",
    "predev": "pnpm run registry:build",
    "build": "next build && node scripts/build-sw.mjs",
    "pwa-icons:generate": "node scripts/generate-pwa-icons.mjs",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "test:portability": "node consumer-tests/portability-test.mjs",
    "test:blocks": "node consumer-tests/blocks-test.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "check:telemetry": "tsx scripts/check-no-shipped-telemetry.ts",
    "block-source:generate": "tsx scripts/generate-block-source.ts"
  },
  "dependencies": {
    "@localmode/chrome-ai": "workspace:*",
    "@localmode/core": "workspace:*",
    "@localmode/devtools": "workspace:*",
    "@localmode/langchain": "workspace:*",
    "@localmode/litert": "workspace:*",
    "@localmode/mediapipe": "workspace:*",
    "@localmode/pdfjs": "workspace:*",
    "@localmode/react": "workspace:*",
    "@localmode/transformers": "workspace:*",
    "@localmode/webllm": "workspace:*",
    "@localmode/wllama": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@serwist/next": "^9.0.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "16.7.4",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-typescript": "^4.0.7",
    "fumadocs-ui": "16.7.4",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "serwist": "^9.0.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.1",
    "postcss": "^8.5.8",
    "shadcn": "^4.9.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
