{
  "name": "LocalMode",
  "version": "2.15.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/LocalMode-AI/LocalMode.git"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^24",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^14.0.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "description": "Local-first AI toolkit for the browser",
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "private": true,
  "pnpm": {
    "overrides": {
      "@babel/core@7": "^7.29.6",
      "@hono/node-server@1": "^1.19.15",
      "@humanfs/node": "^0.16.8",
      "@langchain/core": "^1.2.12",
      "adm-zip@0.5": "^0.6.1",
      "ajv@6": "^6.14.0",
      "baseline-browser-mapping@2": "^2.11.0",
      "body-parser@2": "^2.3.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.9",
      "browserslist@4": "^4.28.7",
      "fast-uri@3": "^3.1.6",
      "flatted": "^3.4.2",
      "hono@4": "^4.13.5",
      "image-size@2": "^2.0.4",
      "ip-address@10": "^10.3.1",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "langsmith": "^0.10.5",
      "minimatch@3": "^3.1.3",
      "minimatch@9": "^9.0.7",
      "nanoid@3": "^3.3.12",
      "path-to-regexp@8": "^8.4.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss-selector-parser@7": "^7.1.3",
      "postcss@<8.5.23": "^8.5.23",
      "protobufjs@7": "^7.6.6",
      "qs@6": "^6.16.0",
      "rollup@4": "^4.59.0",
      "sharp@0.34": "^0.35.4",
      "undici@7": "^7.29.0",
      "uuid@11": "^11.1.1",
      "ws@8": "^8.21.0"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:bench": "pnpm --parallel --filter @localmode/bench --filter @localmode/wllama --filter ui run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit -p packages/core/tsconfig.typetest.json",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish",
    "size": "pnpm run size --workspace=@localmode/core",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "lint:fix": "eslint . --fix",
    "check:peers": "node scripts/check-peer-ranges.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
